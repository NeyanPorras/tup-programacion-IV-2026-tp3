Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "marca": "Renault",
  "modelo": "Master",
  "patente": "AF222BB",
  "anio": 2024,
  "capacidadCarga": 1600
}

### Modificar con id no numerico (400)
PUT {{url}}/vehiculos/1abc
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "marca": "Renault",
  "modelo": "Master",
  "patente": "AF222BB",
  "anio": 2024,
  "capacidadCarga": 1600
}

### Eliminar un vehiculo que tiene viajes (400)
# ------------------------------- BAJA -------------------------------
DELETE {{url}}/vehiculos/1
Authorization: Bearer {{login.response.body.token}}

### Eliminar un vehiculo sin viajes (200)
DELETE {{url}}/vehiculos/4
Authorization: Bearer {{login.response.body.token}}

### Eliminar el mismo vehiculo otra vez (404)
DELETE {{url}}/vehiculos/4
Authorization: Bearer {{login.response.body.token}}

### Eliminar con id no numerico (400)
DELETE {{url}}/vehiculos/1abc
Authorization: Bearer {{login.response.body.token}}

### Eliminar sin token (401)
DELETE {{url}}/vehiculos/2

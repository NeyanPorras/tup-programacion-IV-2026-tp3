### Modificar un vehiculo (200)
# --------------------------- MODIFICACION ---------------------------
PUT {{url}}/vehiculos/4
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "marca": "Renault",
  "modelo": "Master L2H2",
  "patente": "AD789GH",
  "anio": 2024,
  "capacidadCarga": 1750
}

### Modificar usando la patente de otro vehiculo (400)
PUT {{url}}/vehiculos/4
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "marca": "Renault",
  "modelo": "Master L2H2",
  "patente": "AB123CD",
  "anio": 2024,
  "capacidadCarga": 1750
}

### Modificar con datos invalidos (400)
PUT {{url}}/vehiculos/4
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "marca": "Renault",
  "modelo": "Master L2H2",
  "patente": "AD789GH",
  "anio": 2024,
  "capacidadCarga": "mucha"
}


@url = http://localhost:3000

# Las peticiones dependen del orden: la primera registra el usuario que
# usan los casos de email repetido. Para repetir la corrida desde cero,
# volver a crear las tablas con database.sql.

### Registrar un usuario (201)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Ana García",
  "email": "ana.garcia@mail.com",
  "password": "segura123"
}

### Registrar con un email ya usado (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Ana García",
  "email": "ana.garcia@mail.com",
  "password": "segura123"
}

### Registrar con el mismo email en mayusculas y con espacios (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Ana García",
  "email": "  ANA.GARCIA@MAIL.COM  ",
  "password": "segura123"
}

### Registrar sin nombre (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "email": "luis.perez@mail.com",
  "password": "segura123"
}

### Registrar con un nombre que contiene numeros (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Luis P3rez",
  "email": "luis.perez@mail.com",
  "password": "segura123"
}

### Registrar con un nombre de una sola letra (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "L",
  "email": "luis.perez@mail.com",
  "password": "segura123"
}

### Registrar sin email (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Luis Pérez",
  "password": "segura123"
}

### Registrar con un email sin formato valido (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Luis Pérez",
  "email": "luis.perez-arroba-mail.com",
  "password": "segura123"
}

### Registrar sin contraseña (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Luis Pérez",
  "email": "luis.perez@mail.com"
}

### Registrar con una contraseña de menos de 8 caracteres (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Luis Pérez",
  "email": "luis.perez@mail.com",
  "password": "abc12"
}

### Registrar con una contraseña sin numeros (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Luis Pérez",
  "email": "luis.perez@mail.com",
  "password": "solamenteletras"
}

### Registrar con una contraseña de mas de 72 caracteres (400)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Luis Pérez",
  "email": "luis.perez@mail.com",
  "password": "abcdefgh1abcdefgh1abcdefgh1abcdefgh1abcdefgh1abcdefgh1abcdefgh1abcdefgh1a"
}

### Registrar sin body (400)
POST {{url}}/auth/registro
Content-Type: application/json

### Registrar con un JSON mal formado (400)
POST {{url}}/auth/registro
Content-Type: application/json

{ "nombre": "Luis Pérez", }

### Registrar un segundo usuario valido (201)
POST {{url}}/auth/registro
Content-Type: application/json

{
  "nombre": "Luis Pérez",
  "email": "luis.perez@mail.com",
  "password": "otraClave99"
}

### Iniciar sesion con datos correctos (200)
# ------------------------------- LOGIN -------------------------------
# @name login
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "ana.garcia@mail.com",
  "password": "segura123"
}

### Iniciar sesion con el email en mayusculas y con espacios (200)
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "  ANA.GARCIA@MAIL.COM ",
  "password": "segura123"
}

### Iniciar sesion con la contraseña incorrecta (401)
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "ana.garcia@mail.com",
  "password": "otraCosa123"
}

### Iniciar sesion con un email que no esta registrado (401)
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "nadie@mail.com",
  "password": "segura123"
}

### Iniciar sesion sin contraseña (400)
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "ana.garcia@mail.com"
}

### Iniciar sesion con un email sin formato valido (400)
POST {{url}}/auth/login
Content-Type: application/json

{
  "email": "ana.garcia",
  "password": "segura123"
}

### Iniciar sesion sin body (400)
POST {{url}}/auth/login
Content-Type: application/json

### Ver el perfil con el token del login (200)
# ----------------------------- RUTA PROTEGIDA -----------------------------
# Usan el token del request "login" de arriba: ejecutarlo antes.
GET {{url}}/auth/perfil
Authorization: Bearer {{login.response.body.token}}

### Ver el perfil sin token (401)
GET {{url}}/auth/perfil

### Ver el perfil con un token inventado (401)
GET {{url}}/auth/perfil
Authorization: Bearer esto.no.es-un-token

### Ver el perfil con un token adulterado (401)
# Payload cambiado a mano: dice userId 2, pero la firma es la del token original
GET {{url}}/auth/perfil
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjIsIm5vbWJyZSI6IkFuYSBHYXJjw61hIiwiaWF0IjoxNzk0Nzk3MDcxLCJleHAiOjE3OTQ4MTE0NzF9.firma-que-no-coincide

### Ver el perfil sin la palabra Bearer (401)
GET {{url}}/auth/perfil
Authorization: {{login.response.body.token}}
